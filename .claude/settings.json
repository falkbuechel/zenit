{
  "permissions": {
  "defaultMode": "acceptEdits",
  "allow": [
    "Bash(python *)", "Bash(node *)", "Bash(git *)", "Bash(gh *)",
    "Bash(cat *)", "Bash(sed *)", "Bash(grep *)", "Bash(ls *)", "Bash(cp *)", "Bash(wc *)", "Bash(tail *)", "Bash(head *)",
    "Bash(cd *)", "Bash(echo *)", "Bash(npx *)", "Bash(npm *)", "Bash(mkdir *)", "Bash(find *)", "Bash(sort *)", "Bash(diff *)", "Bash(cut *)", "Bash(uniq *)", "Bash(curl *)",
    "PowerShell(python *)", "PowerShell(node *)", "PowerShell(git *)", "PowerShell(gh *)", "PowerShell(npx *)", "PowerShell(npm *)",
    "PowerShell(cd *)", "PowerShell(Get-Content *)", "PowerShell(Get-ChildItem *)", "PowerShell(Select-String *)",
    "PowerShell(Select-Object *)", "PowerShell(Copy-Item *)", "PowerShell(New-Item *)", "PowerShell(Measure-Object *)"
  ],
    "ask": ["Bash(git push *)", "PowerShell(git push *)"],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)", "Bash(rm -rf *)",
      "PowerShell(git push --force*)", "PowerShell(git push -f*)", "PowerShell(git reset --hard*)", "PowerShell(Remove-Item *-Recurse*)",
      "Read(./.env*)", "Read(./**/*backup*.json)", "Edit(./dist/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hook-check.py\"", "timeout": 30 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hook-context.py\"", "timeout": 10 }] }
    ]
  }
}
