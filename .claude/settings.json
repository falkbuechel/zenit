{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash", "PowerShell", "Read", "Edit", "Write", "WebFetch", "WebSearch"],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)", "Bash(rm -rf *)",
      "PowerShell(git push --force*)", "PowerShell(git push -f*)", "PowerShell(git reset --hard*)", "PowerShell(Remove-Item *-Recurse*)",
      "Read(./.env*)", "Read(./**/*backup*.json)", "Edit(./dist/**)",
      "Read(~/.ssh/**)", "Read(~/.config/gh/**)", "Read(~/AppData/Roaming/GitHub CLI/**)", "Read(~/.git-credentials)", "Read(~/.npmrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hook-guard.py\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hook-check.py\"", "timeout": 30 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/tools/hook-context.py\"", "timeout": 10 }] }
    ]
  }
}
